# --- Copiez ce fichier en ".env" et remplissez les valeurs ---

# Port interne de l'app Node (ne pas changer sauf besoin particulier)
PORT=3000

# URL publique du site
# En local, utilisez http://localhost:3000
# En production, utilisez https://RamiGame.gr.com
SITE_URL=http://localhost:3000

# Clé secrète pour chiffrer les sessions (mettez une longue chaîne aléatoire en production)
SESSION_SECRET=changez_cette_valeur_par_une_chaine_aleatoire_longue

# Identifiants Google OAuth (voir README pour les obtenir sur Google Cloud Console)
# Laissez vides pour désactiver la connexion Google (le compte local reste disponible)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
