<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= site.nom %> - 100 jeux gratuits</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header>
    <div class="logo-wrap">
      <button type="button" class="logo" id="logoToggle" aria-expanded="false" aria-controls="logoDropdown">
        <%= site.nom %> <span class="caret">&#9662;</span>
      </button>
      <div class="logo-dropdown" id="logoDropdown">
        <p data-i18n="welcome_msg">You are welcome To RamiGame</p>
      </div>
    </div>
    <nav>
      <% if (user) { %>
        <span><span data-i18n="hello">Bonjour</span>, <%= user.nom || user.email %></span>
        <a href="/logout" class="btn" data-i18n="logout">Déconnexion</a>
      <% } else { %>
        <a href="/login" data-i18n="login">Connexion</a>
        <a href="/register" class="btn" data-i18n="register">S'inscrire</a>
      <% } %>
      <div class="lang-switch">
        <button type="button" data-lang="en">EN</button>
        <button type="button" data-lang="ar">AR</button>
      </div>
    </nav>
  </header>

  <div class="container">
    <section class="ads-section">
      <h2 data-i18n="ads_title">RAMIpublicités</h2>
      <div class="ads-carousel">
        <% ads.forEach(function(ad) { %>
          <div>
            <video controls muted>
              <source src="<%= ad.video %>" type="video/mp4">
              Votre navigateur ne supporte pas la vidéo.
            </video>
            <p><%= ad.titre %></p>
          </div>
        <% }) %>
      </div>
    </section>

    <section class="games-section">
      <h2 data-i18n="games_title">100 Jeux gratuits</h2>
      <div class="games-grid">
        <% games.forEach(function(g) { %>
          <div class="game-card">
            <img src="<%= g.image %>" alt="<%= g.titre %>">
            <div class="info">
              <strong><%= g.titre %></strong><br>
              <small><%= g.categorie %></small>
              <a class="play-btn" href="/jouer/<%= g.id %>" data-i18n="play_btn">Jouer</a>
            </div>
          </div>
        <% }) %>
      </div>
    </section>
  </div>

  <footer>
    <span data-i18n="footer_site">Site :</span> <strong><%= site.domaine %></strong><br>
    <span data-i18n="footer_owner">Propriétaire du site :</span> <strong><%= site.proprietaire %></strong> — <%= site.localisation %>
  </footer>
  <script src="/js/i18n.js"></script>
  <script src="/js/main.js"></script>
</body>
</html>
